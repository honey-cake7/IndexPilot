# Local-only settings. Run `uv run python scripts/init_local.py` to create .env
# and unique passwords in .secrets/. Never commit either generated location.
INDEXPILOT_DB_HOST=127.0.0.1
INDEXPILOT_DB_PORT=55432
INDEXPILOT_SECRET_DIR=.secrets
# Trusted server-side Compose transport; set this to the same project used with compose -p.
INDEXPILOT_COMPOSE_PROJECT=indexpilot
# Cooperative planning budget; cleanup/persistence can extend request duration.
INDEXPILOT_EVALUATION_TIMEOUT_SECONDS=30
# Default stays 1000; raise up to 5000 for larger cumulative statement histories.
INDEXPILOT_STATISTICS_COLLECTION_LIMIT=1000
